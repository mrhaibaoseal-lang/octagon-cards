{
  "permissions": {
    "deny": [
      "Read(./data/fighters.json)",
      "Read(./data/raw_ufcstats.json)",
      "Read(./dist/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
